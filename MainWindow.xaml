<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuickClip.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="QuickClip">

    <Border
        x:Name="CaptureSurface"
        Background="#FF0078D4"
        BorderBrush="#FF0078D4"
        BorderThickness="1"
        DoubleTapped="CaptureSurface_DoubleTapped"
        IsTabStop="True"
        KeyDown="CaptureSurface_KeyDown"
        PointerCanceled="CaptureSurface_PointerReleased"
        PointerCaptureLost="CaptureSurface_PointerCaptureLost"
        PointerMoved="CaptureSurface_PointerMoved"
        PointerPressed="CaptureSurface_PointerPressed"
        PointerReleased="CaptureSurface_PointerReleased">

        <Grid>
            <Button
                x:Name="CloseButton"
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="閉じる"
                Background="#66000000"
                Click="CloseButton_Click"
                Content="&#xE711;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                Foreground="White"
                IsTabStop="False"
                ToolTipService.ToolTip="閉じる" />
        </Grid>
    </Border>
</Window>
